    "serverside",
    "cli",
    "backend",
    "npm",
    "scaffold",
    "backend",
    "express",
    "fastify",
    "api",
    "generator"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "commander": "^15.0.0",
    "execa": "^8.0.1",
    "kolorist": "^1.8.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
