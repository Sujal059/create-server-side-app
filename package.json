{
  "name": "create-server-side-app",
  "version": "2.0.1",
  "description": "Production-grade backend scaffolder for Node, Python, Java, and Go",
  "type": "module",
  "bin": {
    "create-server-side-app": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "build": "tsup src/cli/index.ts --format esm --clean --minify",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run test"
  },
  "files": [
    "dist",
    "templates"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "node",
