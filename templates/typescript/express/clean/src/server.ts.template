import express from 'express';
import helmet from 'helmet';
import cors from 'cors';
import pino from 'pino';
import dotenv from 'dotenv';
import { PrismaUserRepository } from './infrastructure/repositories/user.repository.impl';
import { JwtService } from './infrastructure/security/jwt.service';
import { AuthUseCase } from './usecases/auth.usecase';
import { AuthController } from './interfaces/http/controllers/auth.controller';
import { createAuthRouter } from './interfaces/http/routes/auth.routes';

dotenv.config();

const app = express();
const logger = pino({ level: process.env.LOG_LEVEL || 'info' });

app.use(helmet());
app.use(cors());
app.use(express.json());

// Initialize Clean Architecture layers (Dependency Injection)
const userRepository = new PrismaUserRepository();
const jwtService = new JwtService();
const authUseCase = new AuthUseCase(userRepository, jwtService);
const authController = new AuthController(authUseCase);
const authRouter = createAuthRouter(authController, jwtService);

// Health check
app.get('/health', (req, res) => {
  res.status(200).json({ status: 'ok', architecture: 'clean', timestamp: new Date().toISOString() });
});

// Mount Routes
app.use('/api/v1/auth', authRouter);

// 404 Handler
app.use((req, res) => {
  res.status(404).json({ success: false, message: 'Route not found' });
});

const port = process.env.PORT || 3000;
app.listen(port, () => {
  logger.info(`🚀 Clean Architecture server running on port ${port}`);
});
